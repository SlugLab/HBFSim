+        const bool synchronized = sync && sync() == CUDA_SUCCESS;
+        const bool freed = eval_free(eval_session.modules, free_memory);
+        eval_session = {};
+        return disabled && synchronized && freed ? 0 : -1;
+    } catch (...) { return -9; }
+}
