+        0x9e3779b97f4a7c15ULL, 0xd6e8feb86659fd93ULL};
+    for (const unsigned char ch : identity)
+        for (std::size_t i = 0; i != words.size(); ++i) {
+            words[i] ^= static_cast<std::uint64_t>(ch) + (i << 8);
+            words[i] *= 0x100000001b3ULL + 2 * i;
+        }
