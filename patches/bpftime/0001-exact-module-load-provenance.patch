diff --git a/attach/nv_attach_impl/test/test_module_load_provenance.cpp b/attach/nv_attach_impl/test/test_module_load_provenance.cpp
new file mode 100644
index 0000000..24e716f
--- /dev/null
+++ b/attach/nv_attach_impl/test/test_module_load_provenance.cpp
@@ -0,0 +1,93 @@
+#include "nv_attach_module_load_provenance.hpp"
+
+#include <catch2/catch_test_macros.hpp>
+
+using namespace bpftime::attach;
+
+namespace
+{
+
+int begin_calls;
+int end_calls;
+uint64_t ended_token;
+
+uint64_t begin_matching(const char *ptx, size_t size)
+{
+	REQUIRE(std::string_view(ptx, size) == "patched ptx");
+	begin_calls++;
+	return 0x1234;
+}
+
+uint64_t begin_zero(const char *, size_t)
+{
+	begin_calls++;
+	return 0;
+}
+
+void end_matching(uint64_t token)
+{
+	end_calls++;
+	ended_token = token;
+}
+
+void reset_calls()
+{
+	begin_calls = 0;
+	end_calls = 0;
+	ended_token = 0;
+}
+
+} // namespace
+
+TEST_CASE("both callbacks absent permits standalone module load",
+	  "[module_load_provenance]")
+{
+	module_load_provenance_scope scope("patched ptx", {});
+	REQUIRE(scope.permits_load());
+}
+
+TEST_CASE("partial callback pair rejects module load",
+	  "[module_load_provenance]")
+{
+	SECTION("begin only")
+	{
+		module_load_provenance_scope scope(
+			"patched ptx", { .begin = begin_matching });
+		REQUIRE_FALSE(scope.permits_load());
+	}
+	SECTION("end only")
+	{
+		module_load_provenance_scope scope(
+			"patched ptx", { .end = end_matching });
+		REQUIRE_FALSE(scope.permits_load());
+	}
+}
+
+TEST_CASE("zero begin token rejects module load", "[module_load_provenance]")
+{
+	reset_calls();
+	{
+		module_load_provenance_scope scope(
+			"patched ptx",
+			{ .begin = begin_zero, .end = end_matching });
+		REQUIRE_FALSE(scope.permits_load());
+	}
+	REQUIRE(begin_calls == 1);
+	REQUIRE(end_calls == 0);
+}
+
+TEST_CASE("matching begin and end bracket module load",
+	  "[module_load_provenance]")
+{
+	reset_calls();
+	{
+		module_load_provenance_scope scope(
+			"patched ptx",
+			{ .begin = begin_matching, .end = end_matching });
+		REQUIRE(scope.permits_load());
+		REQUIRE(begin_calls == 1);
+		REQUIRE(end_calls == 0);
+	}
+	REQUIRE(end_calls == 1);
+	REQUIRE(ended_token == 0x1234);
+}
