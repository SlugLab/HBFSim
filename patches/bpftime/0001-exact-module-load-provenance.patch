diff --git a/attach/nv_attach_impl/nv_attach_module_load_provenance.cpp b/attach/nv_attach_impl/nv_attach_module_load_provenance.cpp
new file mode 100644
index 0000000..3b56eb5
--- /dev/null
+++ b/attach/nv_attach_impl/nv_attach_module_load_provenance.cpp
@@ -0,0 +1,47 @@
+#include "nv_attach_module_load_provenance.hpp"
+
+#include <dlfcn.h>
+
+namespace bpftime::attach
+{
+
+module_load_provenance_hooks find_module_load_provenance_hooks()
+{
+	return {
+		.begin = reinterpret_cast<begin_module_load_fn>(dlsym(
+			RTLD_DEFAULT, "hbfsim_begin_module_load_from_ptx")),
+		.end = reinterpret_cast<end_module_load_fn>(
+			dlsym(RTLD_DEFAULT, "hbfsim_end_module_load")),
+	};
+}
+
+module_load_provenance_scope::module_load_provenance_scope(
+	std::string_view ptx, module_load_provenance_hooks hooks)
+{
+	if (hooks.begin == nullptr && hooks.end == nullptr) {
+		permitted_ = true;
+		return;
+	}
+	if (hooks.begin == nullptr || hooks.end == nullptr) {
+		return;
+	}
+	token_ = hooks.begin(ptx.data(), ptx.size());
+	if (token_ == 0) {
+		return;
+	}
+	end_ = hooks.end;
+	permitted_ = true;
+}
+
+module_load_provenance_scope::~module_load_provenance_scope()
+{
+	if (token_ != 0 && end_ != nullptr)
+		end_(token_);
+}
+
+bool module_load_provenance_scope::permits_load() const
+{
+	return permitted_;
+}
+
+} // namespace bpftime::attach
diff --git a/attach/nv_attach_impl/nv_attach_module_load_provenance.hpp b/attach/nv_attach_impl/nv_attach_module_load_provenance.hpp
new file mode 100644
index 0000000..cd7a2f8
--- /dev/null
+++ b/attach/nv_attach_impl/nv_attach_module_load_provenance.hpp
@@ -0,0 +1,39 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <string_view>
+
+namespace bpftime::attach
+{
+
+using begin_module_load_fn = uint64_t (*)(const char *, size_t);
+using end_module_load_fn = void (*)(uint64_t);
+
+struct module_load_provenance_hooks {
+	begin_module_load_fn begin = nullptr;
+	end_module_load_fn end = nullptr;
+};
+
+module_load_provenance_hooks find_module_load_provenance_hooks();
+
+class module_load_provenance_scope {
+    public:
+	module_load_provenance_scope(std::string_view ptx,
+				     module_load_provenance_hooks hooks);
+	~module_load_provenance_scope();
+
+	module_load_provenance_scope(const module_load_provenance_scope &) =
+		delete;
+	module_load_provenance_scope &
+	operator=(const module_load_provenance_scope &) = delete;
+
+	[[nodiscard]] bool permits_load() const;
+
+    private:
+	end_module_load_fn end_ = nullptr;
+	uint64_t token_ = 0;
+	bool permitted_ = false;
+};
+
+} // namespace bpftime::attach
