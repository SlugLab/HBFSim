--- /dev/null
+++ b/attach/nv_attach_impl/nv_attach_aot_load_provenance.hpp
@@ -0,0 +1,40 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <string_view>
+
+namespace bpftime::attach
+{
+
+using begin_aot_module_load_fn =
+	uint64_t (*)(const void *, size_t, const char *, size_t);
+using end_aot_module_load_fn = void (*)(uint64_t);
+
+struct aot_module_load_hooks {
+	begin_aot_module_load_fn begin = nullptr;
+	end_aot_module_load_fn end = nullptr;
+};
+
+[[nodiscard]] aot_module_load_hooks find_aot_module_load_hooks();
+
+class aot_module_load_scope {
+    public:
+	aot_module_load_scope(const void *cubin, size_t cubin_bytes,
+			      std::string_view artifact_json,
+			      aot_module_load_hooks hooks);
+	~aot_module_load_scope();
+
+	aot_module_load_scope(const aot_module_load_scope &) = delete;
+	aot_module_load_scope &
+	operator=(const aot_module_load_scope &) = delete;
+
+	[[nodiscard]] bool permits_load() const;
+
+    private:
+	end_aot_module_load_fn end_ = nullptr;
+	uint64_t token_ = 0;
+	bool permitted_ = false;
+};
+
+} // namespace bpftime::attach
