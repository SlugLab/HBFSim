--- /dev/null
+++ b/attach/nv_attach_impl/nv_attach_ptx_compatibility.hpp
@@ -0,0 +1,139 @@
+#pragma once
+// PTX header metadata only. No instruction, memory, or helper rewriting.
+#include <algorithm>
+#include <map>
+#include <regex>
+#include <stdexcept>
+#include <string>
+#include <utility>
+#include <vector>
+
+namespace bpftime::attach {
+struct ptx_target_name { int number; char feature; std::string text; };
+struct prepared_ptx { std::string text, target, original_version, original_target, effective_version; };
+
+inline ptx_target_name parse_ptx_target(const std::string &text)
+{
+    std::smatch match;
+    if (!std::regex_match(text, match, std::regex("sm_([0-9]+)([af]?)")))
+        throw std::runtime_error("Invalid PTX target: " + text);
+    return {std::stoi(match[1]), match[2].str().empty() ? '\0' : match[2].str()[0], text};
+}
+inline std::pair<int, int> ptx_minimum(const std::string &target)
+{
+    static const std::map<std::string, std::pair<int, int>> known = {
+        {"sm_70",{6,0}}, {"sm_72",{6,1}}, {"sm_75",{6,3}},
+        {"sm_80",{7,0}}, {"sm_86",{7,1}}, {"sm_87",{7,4}},
+        {"sm_89",{7,8}}, {"sm_90",{7,8}},
+        {"sm_90a",{8,0}}, {"sm_100",{8,6}}, {"sm_100a",{8,6}},
+        {"sm_101",{8,6}}, {"sm_101a",{8,6}},
+        {"sm_100f",{8,8}}, {"sm_101f",{8,8}},
+        {"sm_103",{8,8}}, {"sm_103a",{8,8}}, {"sm_103f",{8,8}},
+        {"sm_120",{8,7}}, {"sm_120a",{8,7}}, {"sm_120f",{8,8}},
+        {"sm_121",{8,8}}, {"sm_121a",{8,8}}, {"sm_121f",{8,8}}
+    };
+    auto it = known.find(target);
+    return it == known.end() ? std::pair<int,int>{0,0} : it->second;
+}
+inline int ptx_family(int number)
+{
+    if (number == 100 || number == 103) return 100;
+    if (number == 101) return 101;
+    if (number == 120 || number == 121) return 120;
+    return -1;
+}
+inline std::string compatible_ptx_target(const ptx_target_name &source,
+                                          const ptx_target_name &destination)
+{
+    auto refuse = [&]() -> std::string {
+        throw std::runtime_error("Incompatible PTX source target " + source.text +
+                                 " for destination " + destination.text);
+    };
+    if (source.text == destination.text) return destination.text;
+    if ((source.feature && ptx_minimum(source.text).first == 0) ||
+        (destination.feature && ptx_minimum(destination.text).first == 0))
+        return refuse();
+    // Unknown modern targets may pass through unchanged, never by a guessed range.
+    if ((source.number >= 100 && ptx_minimum(source.text).first == 0) ||
+        (destination.number >= 100 && ptx_minimum(destination.text).first == 0))
+        return refuse();
+    if (source.number > destination.number) return refuse();
+    if (source.feature == 'a') {
+        if (source.number != destination.number || destination.feature == 'f') return refuse();
+        return source.text; // generic capability detection must not erase a
+    }
+    if (source.feature == 'f') {
+        if (ptx_family(source.number) < 0 ||
+            ptx_family(source.number) != ptx_family(destination.number)) return refuse();
+        if (destination.feature == 'a') return destination.text;
+        return "sm_" + std::to_string(destination.number) + "f";
+    }
+    return destination.text;
+}
+inline std::string mask_ptx_comments(std::string text)
+{
+    bool line = false, block = false, quoted = false;
+    for (std::size_t i = 0; i < text.size(); ++i) {
+        if (line) { if (text[i] == '\n') line = false; else text[i] = ' '; continue; }
+        if (block) {
+            if (text[i] == '*' && i + 1 < text.size() && text[i+1] == '/') {
+                text[i] = text[i+1] = ' '; ++i; block = false;
+            } else if (text[i] != '\n' && text[i] != '\r') text[i] = ' ';
+            continue;
+        }
+        if (text[i] == '"' && (i == 0 || text[i-1] != '\\')) quoted = !quoted;
+        if (!quoted && i + 1 < text.size() && text[i] == '/' &&
+            (text[i+1] == '/' || text[i+1] == '*')) {
+            block = text[i+1] == '*'; line = !block;
+            text[i] = text[i+1] = ' '; ++i;
+        }
+    }
+    if (block) throw std::runtime_error("Unterminated PTX block comment");
+    return text;
+}
+inline prepared_ptx prepare_ptx_for_target(const std::string &ptx,
+                                            const std::string &requested)
+{
+    if (requested.empty()) return {ptx, requested, "", "", ""};
+    auto masked = mask_ptx_comments(ptx);
+    const std::regex version_re(R"((^|\n)[ \t]*\.version[ \t]+([0-9]+)\.([0-9]+)([ \t\r]*(?=\n|$)))");
+    std::vector<std::smatch> versions;
+    for (auto it = std::sregex_iterator(masked.begin(), masked.end(), version_re);
+         it != std::sregex_iterator(); ++it) versions.push_back(*it);
+    if (versions.size() != 1) throw std::runtime_error("PTX needs one valid .version directive");
+    auto version = std::pair<int,int>{std::stoi(versions[0][2]), std::stoi(versions[0][3])};
+    const auto original_version = std::to_string(version.first) + "." + std::to_string(version.second);
+    const std::regex target_re(R"((^|\n)[ \t]*\.target[ \t]+([^ \t\r\n,;]+))");
+    std::vector<std::smatch> targets;
+    for (auto it = std::sregex_iterator(masked.begin(), masked.end(), target_re);
+         it != std::sregex_iterator(); ++it) targets.push_back(*it);
+    if (targets.empty()) throw std::runtime_error("PTX needs a .target directive");
+    auto effective = parse_ptx_target(requested);
+    for (const auto &match : targets)
+        effective = parse_ptx_target(compatible_ptx_target(parse_ptx_target(match[2]), effective));
+    // Validate all requirements against the final effective feature target.
+    for (const auto &match : targets) {
+        auto source = parse_ptx_target(match[2]);
+        if (compatible_ptx_target(source, effective) != effective.text)
+            throw std::runtime_error("Conflicting PTX target feature directives");
+        version = std::max(version, ptx_minimum(source.text));
+    }
+    version = std::max(version, ptx_minimum(effective.text));
+    struct replacement { std::size_t position, length; std::string value; };
+    const auto first = targets.front();
+    const auto ver = versions.front();
+    std::vector<replacement> changes = {
+        {static_cast<std::size_t>(ver.position(2)),
+         static_cast<std::size_t>(ver.position(3) + ver.length(3) - ver.position(2)),
+         std::to_string(version.first) + "." + std::to_string(version.second)}
+    };
+    for (const auto &target : targets)
+        changes.push_back({static_cast<std::size_t>(target.position(2)),
+                           static_cast<std::size_t>(target.length(2)), effective.text});
+    std::sort(changes.begin(), changes.end(), [](const auto &a, const auto &b) { return a.position > b.position; });
+    auto output = ptx;
+    for (const auto &change : changes) output.replace(change.position, change.length, change.value);
+    return {output, effective.text, original_version, first[2],
+            std::to_string(version.first) + "." + std::to_string(version.second)};
+}
+} // namespace bpftime::attach
