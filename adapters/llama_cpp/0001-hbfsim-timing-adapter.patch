+using hbfsim_llama_launch_probe_fn = int (*)(
+    uint64_t *, const uint64_t *, uint64_t, cudaStream_t);
+using hbfsim_llama_probe_function_fn = void * (*)();
+using bpftime_nv_bind_ptx_variant_fn = int (*)(
+    void *, const char *, size_t, const char *);
+
+struct hbfsim_llama_state {
+    std::mutex mutex;
+    hbfsim_context * context = nullptr;
+    void * probe_library = nullptr;
+    hbfsim_llama_launch_probe_fn launch_probe = nullptr;
+    void * probe_output = nullptr;
+    void * probe_input = nullptr;
+    uint64_t delay_ns = 0;
+    uint64_t probe_launches = 0;
+    std::string injection_report;
+    hbfsim_exact_run_contract exact_contract{};
+    bool exact_requested = false;
+    bool exact_contract_published = false;
+    bool exact_finalized = false;
+    int device = -1;
+    std::unordered_map<void *, size_t> ranges;
+};
+
+constexpr uint32_t hbfsim_probe_threads = 128;
+constexpr uint32_t hbfsim_probe_depth = 8;
+constexpr uint32_t hbfsim_probe_ring_capacity =
+    hbfsim_probe_threads * hbfsim_probe_depth;
+constexpr uint32_t hbfsim_probe_iterations = 384;
+constexpr uint32_t hbfsim_probe_distance = 32;
+constexpr size_t hbfsim_probe_bytes = 12288;
+constexpr size_t hbfsim_probe_words = hbfsim_probe_bytes / sizeof(uint64_t);
+constexpr uint64_t hbfsim_probe_seed = 0x0123456789abcdefULL;
+constexpr uint64_t hbfsim_probe_slot_mix = 0xd1b54a32d192ed03ULL;
+constexpr uint64_t hbfsim_probe_input_mix = 0x9e3779b97f4a7c15ULL;
+
+uint64_t hbfsim_probe_step(uint64_t value) {
+    value ^= value << 13;
+    value ^= value >> 7;
+    value ^= value << 17;
+    return value;
+}
+
+std::vector<uint64_t> hbfsim_probe_input_values() {
+    std::vector<uint64_t> input(hbfsim_probe_words);
+    for (size_t index = 0; index < input.size(); ++index) {
+        input[index] = hbfsim_probe_seed ^ (index * hbfsim_probe_input_mix);
+    }
+    return input;
+}
+
+std::vector<uint64_t> hbfsim_probe_expected(
+        const std::vector<uint64_t> & input) {
+    std::vector<uint64_t> output(hbfsim_probe_threads);
+    for (uint32_t thread = 0; thread < hbfsim_probe_threads; ++thread) {
+        uint64_t values[hbfsim_probe_depth];
+        for (uint32_t slot = 0; slot < hbfsim_probe_depth; ++slot) {
+            values[slot] = hbfsim_probe_seed ^ (uint64_t{thread} << 32) ^
+                           thread ^ (uint64_t{slot} * hbfsim_probe_slot_mix);
+        }
+        for (uint32_t iteration = 0; iteration < hbfsim_probe_iterations;
+             ++iteration) {
+            for (uint32_t slot = 0; slot < hbfsim_probe_depth; ++slot) {
+                const auto index = (thread * 131U + iteration +
+                                    hbfsim_probe_distance + slot * 17U) %
+                                   hbfsim_probe_words;
+                values[slot] = hbfsim_probe_step(values[slot] ^ input[index]);
+            }
+        }
+        for (uint32_t slot = 0; slot < hbfsim_probe_depth; ++slot) {
+            output[thread] ^= values[slot];
+        }
+    }
+    return output;
+}
+
+hbfsim_llama_state & hbfsim_llama() {
+    static hbfsim_llama_state state;
+    return state;
+}
+
+std::string hbfsim_json_string(const std::string & json, const char * key) {
+    const std::regex expression(std::string("\\\"") + key +
+                                "\\\"\\s*:\\s*\\\"([^\\\"]+)\\\"");
+    std::smatch match;
+    return std::regex_search(json, match, expression) ? match[1].str() : "";
+}
+
+uint64_t hbfsim_json_u64(const std::string & json, const char * key) {
+    const std::regex expression(std::string("\\\"") + key +
+                                "\\\"\\s*:\\s*([0-9]+)");
+    std::smatch match;
+    return std::regex_search(json, match, expression) ? std::stoull(match[1].str()) : 0;
+}
+
+uint32_t hbfsim_model_mode(const std::string & value) {
+    if (value == "reference") return HBFSIM_MODEL_REFERENCE;
+    if (value == "fast") return HBFSIM_MODEL_FAST;
+    if (value == "hybrid") return HBFSIM_MODEL_HYBRID;
+    throw std::runtime_error("LLAMA_HBFSIM_CONFIG has invalid timing_model");
+}
+
+void hbfsim_check(int status, const char * operation) {
+    if (status != HBFSIM_OK) {
+        throw std::runtime_error(std::string(operation) + " failed with HBFSim status " + std::to_string(status));
+    }
+}
+
+void hbfsim_initialize_locked(hbfsim_llama_state & state, int device) {
+    if (state.context != nullptr) return;
+    const char * config_path = std::getenv("LLAMA_HBFSIM_CONFIG");
+    if (config_path == nullptr || config_path[0] == '\0') return;
+    std::ifstream config_input(config_path);
+    if (!config_input) throw std::runtime_error("cannot open LLAMA_HBFSIM_CONFIG");
+    const std::string config{std::istreambuf_iterator<char>(config_input), {}};
+    const auto profile = hbfsim_json_string(config, "profile_path");
+    const auto report = hbfsim_json_string(config, "report_dir");
+    const auto model = hbfsim_json_string(config, "timing_model");
+    const auto probe_path = hbfsim_json_string(config, "probe_ptx");
+    const auto probe_library = hbfsim_json_string(config, "probe_library");
+    const auto delay_ns = hbfsim_json_u64(config, "delay_ns");
+    const auto range_mode = hbfsim_json_string(config, "range_mode");
+    const auto exact_profile = hbfsim_json_string(config, "exact_profile_path");
+    const auto exact_cache = hbfsim_json_string(config, "exact_cache_condition");
+    const auto cluster_x = hbfsim_json_u64(config, "exact_cluster_x");
+    const auto cluster_y = hbfsim_json_u64(config, "exact_cluster_y");
+    const auto cluster_z = hbfsim_json_u64(config, "exact_cluster_z");
+    const bool exact_requested = !exact_profile.empty();
+    if (profile.empty() || report.empty() || model.empty() ||
+        probe_path.empty() || probe_library.empty() ||
+        (!exact_requested && delay_ns == 0)) {
+        throw std::runtime_error("LLAMA_HBFSIM_CONFIG is missing required fields");
+    }
+    if (exact_requested &&
+        (exact_cache != "warm_l2" || cluster_x != 1 || cluster_y != 1 ||
+         cluster_z != 1)) {
+        throw std::runtime_error("LLAMA_HBFSIM_CONFIG has an unproved exact contract");
+    }
+    if (!range_mode.empty() && range_mode != "timing") {
+        throw std::runtime_error("llama.cpp adapter rejects uninstrumented capacity ranges");
+    }
+    hbfsim_options options{
+        profile.c_str(), report.c_str(), hbfsim_model_mode(model),
+        exact_requested ? hbfsim_probe_ring_capacity : 256,
+        30'000'000'000ULL,
+    };
+    if (exact_requested) {
+        const hbfsim_options_v2 exact_options{
+            sizeof(hbfsim_options_v2), options,
+            HBFSIM_FIDELITY_EXACT_SM120, exact_profile.c_str(),
+        };
+        hbfsim_check(hbfsim_context_create_v2(&exact_options, &state.context),
+                     "hbfsim_context_create_v2(exact)");
+        state.exact_contract = {
+            sizeof(hbfsim_exact_run_contract), HBFSIM_EXACT_CACHE_WARM_L2,
+            HBFSIM_EXACT_CONCURRENCY_EXCLUSIVE_PROCESS, 1, 1, 1,
+            HBFSIM_EXACT_OPERATION_ORDINARY_LOAD,
+            uint64_t{hbfsim_probe_threads} * hbfsim_probe_depth *
+                hbfsim_probe_iterations,
+            hbfsim_probe_bytes, 4, hbfsim_probe_depth, 0,
+            hbfsim_probe_iterations, hbfsim_probe_distance, 1, 0,
+        };
+        state.exact_requested = true;
+    } else {
+        hbfsim_check(hbfsim_context_create(&options, &state.context),
+                     "hbfsim_context_create");
+    }
+    state.device = device;
+    state.delay_ns = delay_ns;
+    state.injection_report = report + "/llama-injection.jsonl";
+    std::ifstream ptx_input(probe_path, std::ios::binary);
+    if (!ptx_input) throw std::runtime_error("cannot open HBFSim llama probe PTX");
+    const std::string probe_ptx{std::istreambuf_iterator<char>(ptx_input), {}};
+    // Static llama.cpp fatbins are intentionally skipped by the runner.  Turn
+    // automatic extraction back on only for this small dlopen boundary.
+    (void) unsetenv("BPFTIME_CUDA_DISABLE_CUOBJDUMP");
+    state.probe_library = dlopen(probe_library.c_str(), RTLD_NOW | RTLD_LOCAL);
+    if (state.probe_library == nullptr) {
+        throw std::runtime_error(std::string("cannot load HBFSim llama probe: ") + dlerror());
+    }
+    state.launch_probe = reinterpret_cast<hbfsim_llama_launch_probe_fn>(
+        dlsym(state.probe_library, "hbfsim_llama_launch_probe"));
+    if (state.launch_probe == nullptr) {
+        throw std::runtime_error("HBFSim llama probe is missing launch entrypoint");
+    }
+    if (state.exact_requested) {
+        const auto probe_function = reinterpret_cast<hbfsim_llama_probe_function_fn>(
+            dlsym(state.probe_library, "hbfsim_llama_probe_function"));
+        const auto bind_variant = reinterpret_cast<bpftime_nv_bind_ptx_variant_fn>(
+            dlsym(RTLD_DEFAULT, "bpftime_nv_bind_ptx_variant"));
+        if (probe_function == nullptr || bind_variant == nullptr ||
+            bind_variant(probe_function(), probe_ptx.data(), probe_ptx.size(),
+                         "hbfsim_llama_probe_kernel") != 0) {
+            throw std::runtime_error("exact probe PTX variant binding failed");
+        }
+    }
+    CUDA_CHECK(cudaMalloc(
+        &state.probe_output, hbfsim_probe_threads * sizeof(uint64_t)));
+    if (state.exact_requested) {
+        // The exact profile covers the instrumented sideband probe, not every
+        // opaque kernel in llama.cpp's static CUDA backend.  Keep an isolated
+        // exact probe shadow so ordinary model kernels cannot be mislabeled
+        // exact merely because they consume the same weight allocation.
+        CUDA_CHECK(cudaMalloc(&state.probe_input, hbfsim_probe_bytes));
+        const auto probe_input = hbfsim_probe_input_values();
+        CUDA_CHECK(cudaMemcpy(state.probe_input, probe_input.data(),
+                              hbfsim_probe_bytes, cudaMemcpyHostToDevice));
+        const hbfsim_range_options range{
+            HBFSIM_RANGE_MODE_TIMING, HBFSIM_RANGE_READ,
+            HBFSIM_CACHE_POLICY_NONE, 0,
+        };
+        hbfsim_check(hbfsim_register_device(
+                         state.context, state.probe_input,
+                         hbfsim_probe_bytes, &range),
+                     "hbfsim_register_device(exact probe)");
+    }
+}
+
+bool hbfsim_register_weight_buffer(void * pointer, size_t bytes, int device) {
+    const char * config = std::getenv("LLAMA_HBFSIM_CONFIG");
+    if (config == nullptr || config[0] == '\0') return false;
+    auto & state = hbfsim_llama();
+    std::lock_guard<std::mutex> lock(state.mutex);
+    hbfsim_initialize_locked(state, device);
+    if (state.device != device) {
+        throw std::runtime_error("HBFSim llama adapter supports one CUDA device");
+    }
+    if (state.ranges.find(pointer) != state.ranges.end()) return true;
+    if (state.exact_requested) {
+        state.ranges.emplace(pointer, bytes);
+        GGML_LOG_INFO("HBFSim: sampled CUDA weight buffer %p (%zu bytes) for exact probe shadow\n",
+                      pointer, bytes);
+        return true;
+    }
+    const hbfsim_range_options range{
+        HBFSIM_RANGE_MODE_TIMING, HBFSIM_RANGE_READ,
+        HBFSIM_CACHE_POLICY_NONE, 0,
+    };
+    hbfsim_check(hbfsim_register_device(state.context, pointer, bytes, &range),
+                 "hbfsim_register_device(weight buffer)");
+    state.ranges.emplace(pointer, bytes);
+    if (state.probe_input == nullptr && bytes >= hbfsim_probe_bytes) {
+        state.probe_input = pointer;
+    }
+    GGML_LOG_INFO("HBFSim: registered CUDA weight buffer %p (%zu bytes)\n", pointer, bytes);
+    return true;
+}
+
+void hbfsim_unregister_weight_buffer(void * pointer) noexcept {
+    auto & state = hbfsim_llama();
+    std::lock_guard<std::mutex> lock(state.mutex);
+    if (state.ranges.find(pointer) == state.ranges.end()) return;
+    if (state.context != nullptr && state.exact_requested &&
+        !state.exact_finalized) {
+        if (cudaDeviceSynchronize() != cudaSuccess ||
+            hbfsim_finalize_exact(state.context) != HBFSIM_OK) {
+            GGML_LOG_ERROR("HBFSim: exact post-run finalization failed\n");
+            std::abort();
+        }
+        state.exact_finalized = true;
+    }
+    if (state.context != nullptr && !state.exact_requested &&
+        hbfsim_unregister(state.context, pointer) != HBFSIM_OK) {
+        GGML_LOG_ERROR("HBFSim: failed to unregister CUDA weight buffer %p\n", pointer);
+        return;
+    }
+    state.ranges.erase(pointer);
+    if (!state.exact_requested && state.probe_input == pointer) {
+        state.probe_input = state.ranges.empty() ? nullptr : state.ranges.begin()->first;
+    }
+    if (!state.ranges.empty()) return;
+    if (state.context != nullptr && state.exact_requested &&
+        state.probe_input != nullptr &&
+        hbfsim_unregister(state.context, state.probe_input) != HBFSIM_OK) {
+        GGML_LOG_ERROR("HBFSim: failed to unregister exact probe shadow\n");
+        return;
+    }
+    hbfsim_stats stats{};
+    if (state.context != nullptr &&
+        hbfsim_get_stats(state.context, &stats) == HBFSIM_OK) {
+        GGML_LOG_INFO("HBFSim llama stats: submitted=%llu completed=%llu fast=%llu reference=%llu modeled_ns=%llu probe_launches=%llu injected_ns=%llu\n",
+                      (unsigned long long) stats.requests_submitted,
+                      (unsigned long long) stats.requests_completed,
+                      (unsigned long long) stats.fast_requests,
+                      (unsigned long long) stats.reference_requests,
+                      (unsigned long long) stats.fast_modeled_ns,
+                      (unsigned long long) state.probe_launches,
+                      (unsigned long long) (state.probe_launches * state.delay_ns));
+    }
+    if (state.exact_requested && state.probe_input != nullptr) {
+        (void) cudaFree(state.probe_input);
+    }
+    if (state.probe_output != nullptr) (void) cudaFree(state.probe_output);
+    if (state.probe_library != nullptr) (void) dlclose(state.probe_library);
+    if (state.context != nullptr) hbfsim_context_destroy(state.context);
+    state.context = nullptr;
+    state.probe_output = nullptr;
+    state.probe_library = nullptr;
+    state.launch_probe = nullptr;
+    state.probe_input = nullptr;
+    state.delay_ns = 0;
+    state.probe_launches = 0;
+    state.injection_report.clear();
+    state.exact_contract = {};
+    state.exact_requested = false;
+    state.exact_contract_published = false;
+    state.exact_finalized = false;
+    state.device = -1;
+}
+
+void hbfsim_launch_llama_probe(cudaStream_t stream) {
+    auto & state = hbfsim_llama();
+    std::lock_guard<std::mutex> lock(state.mutex);
+    if (state.context == nullptr || state.probe_input == nullptr ||
+        state.probe_output == nullptr || state.launch_probe == nullptr) return;
+    if (state.exact_requested && !state.exact_contract_published) {
+        hbfsim_check(hbfsim_publish_exact_run_contract(
+                         state.context, &state.exact_contract),
+                     "hbfsim_publish_exact_run_contract");
+        state.exact_contract_published = true;
+    }
+    CUDA_CHECK(static_cast<cudaError_t>(state.launch_probe(
+        static_cast<uint64_t *>(state.probe_output),
+        state.exact_requested
+            ? static_cast<const uint64_t *>(state.probe_input) : nullptr,
+        state.delay_ns, stream)));
+    ++state.probe_launches;
+    std::ofstream trace(state.injection_report, std::ios::app);
+    if (!state.exact_requested) {
+        trace << "{\"launch\":" << state.probe_launches
+              << ",\"delay_ns\":" << state.delay_ns << "}\n";
+    }
+    if (state.exact_requested) {
+        // Exact mode is a one-shot exact probe.  Finalize and release its
+        // owner before llama.cpp launches opaque static CUDA graph kernels;
+        // those kernels remain native/emulation and are never mislabeled.
+        CUDA_CHECK(cudaStreamSynchronize(stream));
+        const auto probe_input = hbfsim_probe_input_values();
+        const auto expected = hbfsim_probe_expected(probe_input);
+        std::vector<uint64_t> observed(hbfsim_probe_threads);
+        CUDA_CHECK(cudaMemcpy(observed.data(), state.probe_output,
+                              observed.size() * sizeof(uint64_t),
+                              cudaMemcpyDeviceToHost));
+        if (observed != expected) {
+            throw std::runtime_error("HBFSim exact probe output mismatch");
+        }
+        trace << "{\"launch\":" << state.probe_launches
+              << ",\"delay_ns\":0,\"bit_exact\":true"
+              << ",\"output_count\":" << observed.size()
+              << ",\"issued_operations\":"
+              << uint64_t{hbfsim_probe_threads} * hbfsim_probe_depth *
+                     hbfsim_probe_iterations
+              << "}\n";
+        trace.flush();
+        if (!trace) {
+            throw std::runtime_error("HBFSim exact probe evidence write failed");
+        }
+        hbfsim_check(hbfsim_finalize_exact(state.context),
+                     "hbfsim_finalize_exact(probe)");
+        state.exact_finalized = true;
+        hbfsim_check(hbfsim_unregister(state.context, state.probe_input),
+                     "hbfsim_unregister(exact probe)");
+        (void) cudaFree(state.probe_input);
+        state.probe_input = nullptr;
+        hbfsim_context_destroy(state.context);
+        state.context = nullptr;
+    }
+}
