+#include "../strict_launch_policy.hpp"
+#include <cassert>
+#include <cstring>
+using bpftime::attach::strict_launch_action;
+using bpftime::attach::strict_launch_policy;
+using bpftime::attach::strict_pointer_json;
+
+int main()
+{
+	assert(strict_launch_policy(false, 2, true) ==
+	       strict_launch_action::reject);
+	assert(strict_launch_policy(true, 0, true) ==
+	       strict_launch_action::reject);
+	assert(strict_launch_policy(true, 1, false) ==
+	       strict_launch_action::original);
+	assert(strict_launch_policy(true, 1, true) ==
+	       strict_launch_action::original);
+	assert(strict_launch_policy(true, 2, false) ==
+	       strict_launch_action::reject);
+	assert(strict_launch_policy(true, 2, true) ==
+	       strict_launch_action::patched);
+	assert(strict_launch_policy(true, -1, true) ==
+	       strict_launch_action::reject);
+	assert(strict_launch_policy(true, 3, true) ==
+	       strict_launch_action::reject);
+	char pointer_json[40] = {};
+	assert(std::strcmp(strict_pointer_json(0, pointer_json,
+					       sizeof(pointer_json)), "null") == 0);
+	assert(std::strcmp(strict_pointer_json(0x1234, pointer_json,
+					       sizeof(pointer_json)), "\"0x1234\"") == 0);
+	return 0;
+}
