+#include "nv_attach_aot_load_provenance.hpp"
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <array>
+
+using namespace bpftime::attach;
+
+namespace
+{
+
+int begin_calls;
+int end_calls;
+uint64_t ended_token;
+
+uint64_t begin_matching(const void *cubin, size_t bytes,
+			const char *artifact, size_t artifact_bytes)
+{
+	REQUIRE(cubin != nullptr);
+	REQUIRE(bytes == 4);
+	REQUIRE(std::string_view(artifact, artifact_bytes) == "{}");
+	begin_calls++;
+	return 0x4321;
+}
+
+uint64_t begin_zero(const void *, size_t, const char *, size_t)
+{
+	begin_calls++;
+	return 0;
+}
+
+void end_matching(uint64_t token)
+{
+	end_calls++;
+	ended_token = token;
+}
+
+void reset_calls()
+{
+	begin_calls = 0;
+	end_calls = 0;
+	ended_token = 0;
+}
+
+} // namespace
+
+TEST_CASE("missing hooks reject AOT module load", "[aot_load_provenance]")
+{
+	const std::array<unsigned char, 4> cubin{};
+	aot_module_load_scope scope(cubin.data(), cubin.size(), "{}", {});
+	REQUIRE_FALSE(scope.permits_load());
+}
+
+TEST_CASE("partial hooks reject AOT module load", "[aot_load_provenance]")
+{
+	const std::array<unsigned char, 4> cubin{};
+	SECTION("begin only")
+	{
+		aot_module_load_scope scope(
+			cubin.data(), cubin.size(), "{}",
+			{ .begin = begin_matching });
+		REQUIRE_FALSE(scope.permits_load());
+	}
+	SECTION("end only")
+	{
+		aot_module_load_scope scope(
+			cubin.data(), cubin.size(), "{}",
+			{ .end = end_matching });
+		REQUIRE_FALSE(scope.permits_load());
+	}
+}
+
+TEST_CASE("zero begin token rejects AOT module load",
+	  "[aot_load_provenance]")
+{
+	reset_calls();
+	const std::array<unsigned char, 4> cubin{};
+	{
+		aot_module_load_scope scope(
+			cubin.data(), cubin.size(), "{}",
+			{ .begin = begin_zero, .end = end_matching });
+		REQUIRE_FALSE(scope.permits_load());
+	}
+	REQUIRE(begin_calls == 1);
+	REQUIRE(end_calls == 0);
+}
+
+TEST_CASE("successful begin ends once", "[aot_load_provenance]")
+{
+	reset_calls();
+	const std::array<unsigned char, 4> cubin{};
+	{
+		aot_module_load_scope scope(
+			cubin.data(), cubin.size(), "{}",
+			{ .begin = begin_matching, .end = end_matching });
+		REQUIRE(scope.permits_load());
+		REQUIRE(begin_calls == 1);
+		REQUIRE(end_calls == 0);
+	}
+	REQUIRE(end_calls == 1);
+	REQUIRE(ended_token == 0x4321);
+}
