+        rejected = [r["kernel"] for r in results if r["status"] != "SUPPORTED_TRANSFORMED"]
+        selected_is_all = set(selected) == set(all_entries)
+        fully_ready = selected_is_all and not rejected and len(transformed) == len(all_entries)
