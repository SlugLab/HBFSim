+			cudaError_t runtime_result)
+{
+	if (frame.driver_calls == 0 && frame.original_completion &&
+	    frame.gate_decision == 1 &&
+	    frame.gate_runtime_result == static_cast<int>(runtime_result))
+		return { runtime_result,
