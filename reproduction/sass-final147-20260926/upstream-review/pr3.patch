+fn cs2r_reads_srz(inst: &EnhancedSassInstruction) -> bool {
+    matches!(
+        inst.src_operands.as_slice(),
+        [SassOperand::SpecialRegister(name) | SassOperand::Label(name)]
+            if matches!(name.as_str(), "SRZ" | "SR_Z")
