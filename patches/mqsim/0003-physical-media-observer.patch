diff --git a/src/nvm_chip/flash_memory/Media_Activity_Observer.h b/src/nvm_chip/flash_memory/Media_Activity_Observer.h
new file mode 100644
index 0000000..51e1e83
--- /dev/null
+++ b/src/nvm_chip/flash_memory/Media_Activity_Observer.h
@@ -0,0 +1,45 @@
+#ifndef MEDIA_ACTIVITY_OBSERVER_H
+#define MEDIA_ACTIVITY_OBSERVER_H
+
+#include <cstdint>
+
+namespace NVM
+{
+	namespace FlashMemory
+	{
+		enum class Media_Activity_Kind : std::uint8_t
+		{
+			READ,
+			PROGRAM,
+			ERASE
+		};
+
+		enum class Media_Transaction_Source : std::uint8_t
+		{
+			USER_IO,
+			CACHE,
+			GC_WL,
+			MAPPING
+		};
+
+		struct Media_Activity
+		{
+			Media_Activity_Kind Kind;
+			std::uint64_t Start_time_ns;
+			std::uint64_t End_time_ns;
+			std::uint32_t Channel;
+			std::uint32_t Chip;
+			std::uint32_t Die;
+			std::uint32_t Plane;
+			std::uint64_t Block;
+			std::uint64_t Page;
+			std::uint64_t Bytes;
+			Media_Transaction_Source Source;
+		};
+
+		using Media_Activity_Observer = void (*)(
+			const Media_Activity& activity, void* context) noexcept;
+	}
+}
+
+#endif // !MEDIA_ACTIVITY_OBSERVER_H
