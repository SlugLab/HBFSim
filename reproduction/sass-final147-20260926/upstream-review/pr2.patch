+    #[test]
+    fn sass_lifter_preserves_imad_hi_u32_modifiers() {
+        let text = r#"Function : imad_hi_u32
+        /*04a0*/ IMAD.HI.U32 R19, R19, R21, R18 ; /* 0x0000001513137227 */
+        /*04c0*/ IMAD.HI.U32 R19, R19, R21, RZ ; /* 0x0000001513137227 */
+        /*04d0*/ EXIT ;
+"#;
