+	    << "\",\"object\":\"0x"
+	    << reinterpret_cast<std::uintptr_t>(object) << std::dec
+	    << "\",\"generation\":" << generation << ",\"symbol\":\""
+	    << registration_json_escape(symbol) << "\",\"object_dso\":\""
+	    << registration_json_escape(dso) << "\"}\n";
