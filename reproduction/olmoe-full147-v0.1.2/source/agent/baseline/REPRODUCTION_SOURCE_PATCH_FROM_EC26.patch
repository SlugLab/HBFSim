+	Dl_info info{};
+	const char *dso = object != nullptr && dladdr(object, &info) != 0 &&
+				       info.dli_fname != nullptr
+			  ? info.dli_fname : "";
+	static std::mutex log_mutex;
+	std::lock_guard<std::mutex> guard(log_mutex);
