.version 9.0
.target sm_120
.address_size 64

.visible .entry tma_im2col_store_sm120(
    .param .u64 tmap,
    .param .u64 source
)
{
    .reg .b64 %rd<4>;
    .reg .b32 %r<4>;
    ld.param.u64 %rd1, [tmap];
    ld.param.u64 %rd2, [source];
    cvta.to.shared.u64 %rd3, %rd2;
    mov.u32 %r1, 0;
    mov.u32 %r2, 0;
    mov.u32 %r3, 0;
    fence.proxy.tensormap::generic.acquire.gpu [%rd1], 128;
    cp.async.bulk.tensor.3d.global.shared::cta.im2col_no_offs.bulk_group
        [%rd1, {%r1, %r2, %r3}], [%rd3];
    cp.async.bulk.commit_group;
    cp.async.bulk.wait_group.read 0;
    cp.async.bulk.wait_group 0;
    ret;
}
