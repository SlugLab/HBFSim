diff --git a/src/ssd/Host_Interface_HBF.cpp b/src/ssd/Host_Interface_HBF.cpp
new file mode 100644
index 0000000..194a1c4
--- /dev/null
+++ b/src/ssd/Host_Interface_HBF.cpp
@@ -0,0 +1,118 @@
+#include "Host_Interface_HBF.h"
+
+#include <stdexcept>
+#include <utility>
+
+namespace SSD_Components
+{
+	Input_Stream_Manager_HBF::Input_Stream_Manager_HBF(
+		Host_Interface_Base* host_interface)
+		: Input_Stream_Manager_Base(host_interface)
+	{
+		input_streams.push_back(new Input_Stream_Base());
+	}
+
+	void Input_Stream_Manager_HBF::Handle_new_arrived_request(
+		User_Request* request)
+	{
+		request->Stream_id = 0;
+		request->STAT_InitiationTime = Simulator->Time();
+		if (request->Type == UserRequestType::READ) {
+			input_streams[0]->STAT_number_of_read_requests++;
+		} else {
+			input_streams[0]->STAT_number_of_write_requests++;
+		}
+		segment_user_request(request);
+		host_interface->broadcast_user_request_arrival_signal(request);
+	}
+
+	void Input_Stream_Manager_HBF::Handle_arrived_write_data(
+		User_Request* request)
+	{
+		Handle_new_arrived_request(request);
+	}
+
+	void Input_Stream_Manager_HBF::Handle_serviced_request(User_Request* request)
+	{
+		Host_Interface_HBF* hbf =
+			static_cast<Host_Interface_HBF*>(host_interface);
+		auto callback = hbf->callbacks.find(request);
+		if (callback == hbf->callbacks.end()) {
+			throw std::logic_error("HBF completion has no registered callback");
+		}
+		request->STAT_ResponseTime = Simulator->Time();
+		callback->second(request, Simulator->Time());
+		hbf->callbacks.erase(callback);
+		delete request;
+	}
+
+	void Input_Stream_Manager_HBF::segment_user_request(
+		User_Request* user_request)
+	{
+		LHA_type lsa = user_request->Start_LBA;
+		unsigned int handled_sectors = 0;
+		while (handled_sectors < user_request->SizeInSectors) {
+			const unsigned int page_offset =
+				static_cast<unsigned int>(lsa % host_interface->sectors_per_page);
+			unsigned int transaction_size =
+				host_interface->sectors_per_page - page_offset;
+			if (handled_sectors + transaction_size >
+				user_request->SizeInSectors) {
+				transaction_size =
+					user_request->SizeInSectors - handled_sectors;
+			}
+
+			const LPA_type lpa = lsa / host_interface->sectors_per_page;
+			const page_status_type bitmap =
+				((~page_status_type{0}) >>
+				  (sizeof(page_status_type) * 8 - transaction_size))
+				 << page_offset;
+			if (user_request->Type == UserRequestType::READ) {
+				user_request->Transaction_list.push_back(
+					new NVM_Transaction_Flash_RD(
+						Transaction_Source_Type::USERIO, 0,
+						transaction_size * SECTOR_SIZE_IN_BYTE, lpa, NO_PPA,
+						user_request, 0, bitmap, CurrentTimeStamp));
+				input_streams[0]->STAT_number_of_read_transactions++;
+			} else {
+				user_request->Transaction_list.push_back(
+					new NVM_Transaction_Flash_WR(
+						Transaction_Source_Type::USERIO, 0,
+						transaction_size * SECTOR_SIZE_IN_BYTE, lpa,
+						user_request, 0, bitmap, CurrentTimeStamp));
+				input_streams[0]->STAT_number_of_write_transactions++;
+			}
+			lsa += transaction_size;
+			handled_sectors += transaction_size;
+		}
+	}
+
+	Host_Interface_HBF::Host_Interface_HBF(
+		const sim_object_id_type& id, LHA_type max_logical_sector_address,
+		unsigned int sectors_per_page, Data_Cache_Manager_Base* cache)
+		: Host_Interface_Base(id, HostInterface_Types::HBF,
+			max_logical_sector_address, sectors_per_page, cache)
+	{
+		input_stream_manager = new Input_Stream_Manager_HBF(this);
+	}
+
+	void Host_Interface_HBF::Submit_hbf_request(
+		User_Request* request, HbfCompletionCallback callback)
+	{
+		if (request == NULL || !callback) {
+			throw std::invalid_argument("invalid HBF request or callback");
+		}
+		if (request->Start_LBA + request->SizeInSectors >
+			max_logical_sector_address) {
+			throw std::out_of_range("HBF request exceeds logical capacity");
+		}
+		callbacks.emplace(request, std::move(callback));
+		input_stream_manager->Handle_new_arrived_request(request);
+	}
+
+	void Host_Interface_HBF::Start_simulation() {}
+	void Host_Interface_HBF::Validate_simulation_config() {}
+	void Host_Interface_HBF::Execute_simulator_event(MQSimEngine::Sim_Event*) {}
+	void Host_Interface_HBF::Report_results_in_XML(
+		std::string, Utils::XmlWriter&) {}
+}
