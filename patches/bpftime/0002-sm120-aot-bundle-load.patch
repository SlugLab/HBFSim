+#pragma once
+
+#include <cstdint>
+#include <string>
+#include <string_view>
+#include <vector>
+
+namespace bpftime::attach
+{
+
+struct exact_aot_bundle {
+	std::vector<uint8_t> cubin;
+	std::string artifact_json;
+	std::string ptx_target;
+	std::string transformed_ptx_sha256;
+	std::string cubin_sha256;
+};
