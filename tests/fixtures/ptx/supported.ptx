.version 8.7
.target sm_120
.address_size 64

.func (.param .align 8 .b8 __hbfsim_ret[16]) __hbfsim_resolve(
    .param .b64 __hbfsim_addr,
    .param .b32 __hbfsim_bytes,
    .param .b32 __hbfsim_kind
)
{
    .reg .b64 %rd1;
    .reg .b32 %r1;
    ld.param.b64 %rd1, [__hbfsim_addr];
    mov.u32 %r1, 1;
    st.param.b64 [__hbfsim_ret+0], %rd1;
    st.param.b32 [__hbfsim_ret+8], %r1;
    ret;
}

.func __hbfsim_fault(
    .param .b32 __hbfsim_status
)
{
    ret;
}

.visible .entry kernel(
    .param .u64 kernel_ptr
)
{
    .reg .pred %p1;
    .reg .b32 %r<8>;
    .reg .b64 %rd<8>;
    ld.param.u64 %rd1, [kernel_ptr];
    @%p1 ld.global.v2.u32 {%r4,%r5}, [%rd1+16];
    ld.global.nc.L2::128B.u64 %rd2, [%rd1];
    st.global.release.gpu.u32 [%rd1-4], %r2;
    ret;
}
