+int joint_abort() noexcept
+{
+    try {
+        auto launch_exclusion = runtime_gate().accounting_transition_guard();
+        std::lock_guard lock(access_accounting_mutex);
+        if (!joint_session_owned && !access_session.active && !eval_session.active)
+            return 0;
