diff --git a/attach/nv_attach_impl/nv_attach_aot_bundle.cpp b/attach/nv_attach_impl/nv_attach_aot_bundle.cpp
new file mode 100644
index 0000000..161cf45
--- /dev/null
+++ b/attach/nv_attach_impl/nv_attach_aot_bundle.cpp
@@ -0,0 +1,167 @@
+#include "nv_attach_aot_bundle.hpp"
+
+#include "nv_attach_utils.hpp"
+
+#include <algorithm>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <regex>
+#include <stdexcept>
+
+namespace bpftime::attach
+{
+namespace
+{
+
+namespace fs = std::filesystem;
+constexpr std::uintmax_t kMaxCubinBytes = 1024ULL * 1024 * 1024;
+constexpr std::uintmax_t kMaxArtifactBytes = 16ULL * 1024 * 1024;
+
+bool lowercase_sha256(std::string_view value)
+{
+	return value.size() == 64 &&
+	       std::all_of(value.begin(), value.end(), [](char character) {
+		       return (character >= '0' && character <= '9') ||
+			      (character >= 'a' && character <= 'f');
+	       });
+}
+
+bool supported_target(std::string_view value)
+{
+	return value == "sm_120" || value == "sm_120a" ||
+	       value == "sm_120f";
+}
+
+std::string unique_json_string(std::string_view document,
+			       std::string_view key)
+{
+	const std::regex expression(
+		"\\\"" + std::string(key) +
+		"\\\"[[:space:]]*:[[:space:]]*\\\"([^\\\"]+)\\\"");
+	std::cmatch match;
+	const std::string text(document);
+	if (!std::regex_search(text.c_str(), match, expression))
+		throw std::runtime_error("AOT artifact field is missing: " +
+					 std::string(key));
+	const auto first = match[1].str();
+	const auto suffix = match.suffix().first;
+	if (std::regex_search(suffix, text.c_str() + text.size(), match,
+			      expression))
+		throw std::runtime_error("AOT artifact field is duplicated: " +
+					 std::string(key));
+	return first;
+}
+
+std::vector<uint8_t> read_binary(const fs::path &path,
+				 std::uintmax_t maximum)
+{
+	const auto bytes = fs::file_size(path);
+	if (bytes == 0 || bytes > maximum)
+		throw std::runtime_error("AOT bundle file size is invalid: " +
+					 path.string());
+	std::ifstream input(path, std::ios::binary);
+	if (!input)
+		throw std::runtime_error("Unable to open AOT bundle file: " +
+					 path.string());
+	std::vector<uint8_t> result(static_cast<std::size_t>(bytes));
+	input.read(reinterpret_cast<char *>(result.data()),
+		   static_cast<std::streamsize>(result.size()));
+	if (input.bad() || input.gcount() !=
+				 static_cast<std::streamsize>(result.size()) ||
+	    input.peek() != std::char_traits<char>::eof())
+		throw std::runtime_error("Unable to read complete AOT bundle file: " +
+					 path.string());
+	return result;
+}
+
+void require_bounded_regular_file(const fs::path &path,
+				  std::uintmax_t maximum)
+{
+	if (fs::is_symlink(fs::symlink_status(path)) ||
+	    !fs::is_regular_file(path) || fs::file_size(path) == 0 ||
+	    fs::file_size(path) > maximum)
+		throw std::runtime_error("AOT bundle member is unsafe: " +
+					 path.string());
+}
+
+} // namespace
+
+bool exact_aot_enabled()
+{
+	return std::getenv("HBFSIM_EXACT_BUNDLE_DIR") != nullptr;
+}
+
+exact_aot_bundle
+load_exact_aot_bundle(std::string_view original_ptx_sha256)
+{
+	if (!lowercase_sha256(original_ptx_sha256))
+		throw std::runtime_error("Original PTX digest is not lowercase SHA256");
+	const char *root_text = std::getenv("HBFSIM_EXACT_BUNDLE_DIR");
+	if (root_text == nullptr || root_text[0] == '\0')
+		throw std::runtime_error("HBFSIM_EXACT_BUNDLE_DIR is empty");
+	fs::path requested_root(root_text);
+	if (fs::is_symlink(fs::symlink_status(requested_root)))
+		throw std::runtime_error("AOT bundle root must not be a symlink");
+	const auto root = fs::canonical(requested_root);
+	if (!fs::is_directory(root))
+		throw std::runtime_error("AOT bundle root is not a directory");
+	const auto digest_directory =
+		root / std::string(original_ptx_sha256);
+	if (fs::is_symlink(fs::symlink_status(digest_directory)) ||
+	    !fs::is_directory(digest_directory) ||
+	    fs::canonical(digest_directory).parent_path() != root)
+		throw std::runtime_error("AOT digest directory is unsafe");
+
+	std::vector<fs::path> candidates;
+	for (const auto &entry : fs::directory_iterator(digest_directory)) {
+		if (fs::is_symlink(entry.symlink_status()))
+			throw std::runtime_error("AOT target directory is a symlink");
+		if (entry.is_directory() &&
+		    supported_target(entry.path().filename().string()))
+			candidates.push_back(entry.path());
+	}
+	if (candidates.size() != 1)
+		throw std::runtime_error(
+			"Expected exactly one SM120 AOT target bundle");
+	const auto target_directory = fs::canonical(candidates.front());
+	if (target_directory.parent_path() !=
+	    fs::canonical(digest_directory))
+		throw std::runtime_error("AOT target escaped digest directory");
+
+	const auto cubin_path = target_directory / "module.cubin";
+	const auto artifact_path = target_directory / "artifact.json";
+	require_bounded_regular_file(cubin_path, kMaxCubinBytes);
+	require_bounded_regular_file(artifact_path, kMaxArtifactBytes);
+	if (fs::canonical(cubin_path).parent_path() != target_directory ||
+	    fs::canonical(artifact_path).parent_path() != target_directory)
+		throw std::runtime_error("AOT bundle member escaped target directory");
+
+	auto cubin = read_binary(cubin_path, kMaxCubinBytes);
+	auto artifact_bytes = read_binary(artifact_path, kMaxArtifactBytes);
+	std::string artifact_json(artifact_bytes.begin(), artifact_bytes.end());
+	const auto artifact_original =
+		unique_json_string(artifact_json, "original_ptx_sha256");
+	const auto artifact_transformed =
+		unique_json_string(artifact_json, "transformed_ptx_sha256");
+	const auto artifact_cubin =
+		unique_json_string(artifact_json, "cubin_sha256");
+	const auto artifact_target =
+		unique_json_string(artifact_json, "ptx_target");
+	if (artifact_original != original_ptx_sha256 ||
+	    artifact_target != target_directory.filename() ||
+	    !supported_target(artifact_target) ||
+	    !lowercase_sha256(artifact_transformed) ||
+	    !lowercase_sha256(artifact_cubin) ||
+	    sha256(cubin.data(), cubin.size()) != artifact_cubin)
+		throw std::runtime_error("AOT artifact identity mismatch");
+	return {
+		.cubin = std::move(cubin),
+		.artifact_json = std::move(artifact_json),
+		.ptx_target = artifact_target,
+		.transformed_ptx_sha256 = artifact_transformed,
+		.cubin_sha256 = artifact_cubin,
+	};
+}
+
+} // namespace bpftime::attach
