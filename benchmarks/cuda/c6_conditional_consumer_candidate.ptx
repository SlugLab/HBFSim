.version 8.7
.target sm_120
.address_size 64

// One block of 32 lanes. Every lane produces one ordinary u32 future.
// first_consumer_mask controls only the first consumer; the second always runs.
// The three fixed acquisitions use input_stride_bytes=4 and masks 0/all/mixed.
.visible .entry c6_conditional_consumer_candidate(
    .param .u64 .ptr .global .align 4 input,
    .param .u64 .ptr .global .align 4 output,
    .param .u32 seed,
    .param .u32 input_stride_bytes,
    .param .u32 first_consumer_mask
)
.reqntid 32, 1, 1
{
    .reg .pred %p<1>;
    .reg .b32 %r<16>;
    .reg .b64 %rd<6>;

    ld.param.u64 %rd0, [input];
    ld.param.u64 %rd1, [output];
    ld.param.u32 %r1, [seed];
    ld.param.u32 %r2, [input_stride_bytes];
    ld.param.u32 %r3, [first_consumer_mask];
    mov.u32 %r0, %tid.x;

    mul.wide.u32 %rd2, %r0, %r2;
    add.u64 %rd3, %rd0, %rd2;
    mul.wide.u32 %rd4, %r0, 4;
    add.u64 %rd5, %rd1, %rd4;
    shl.b32 %r4, 1, %r0;
    and.b32 %r5, %r4, %r3;
    setp.ne.u32 %p0, %r5, 0;

    mov.u32 %r6, 0;
    ld.global.u32 %r6, [%rd3];
    xor.b32 %r7, %r1, %r0;
    mad.lo.u32 %r8, %r7, 0x0019660d, 0x3c6ef35f;
    shl.b32 %r9, %r8, 7;
    shr.u32 %r10, %r8, 25;
    or.b32 %r11, %r9, %r10;
    xor.b32 %r12, %r11, 0x85ebca6b;
    mul.lo.u32 %r12, %r12, 0x85ebca77;

    mov.u32 %r13, %r12;
    @%p0 add.u32 %r13, %r6, %r12;
    xor.b32 %r14, %r6, %r13;
    st.global.u32 [%rd5], %r14;
    ret;
}
