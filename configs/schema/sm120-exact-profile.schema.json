{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hbfsim.local/schema/sm120-exact-profile.schema.json",
  "title": "HBFSim SM120 exact calibration profile",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "target", "toolchain", "conditions", "thresholds", "limits", "modules", "validation"],
  "properties": {
    "schema_version": {"enum": [1, 2]},
    "profile_id": {"type": "string", "minLength": 1},
    "target": {"$ref": "#/$defs/target"},
    "toolchain": {"$ref": "#/$defs/toolchain"},
    "conditions": {"$ref": "#/$defs/conditions"},
    "thresholds": {"$ref": "#/$defs/thresholds"},
    "limits": {"$ref": "#/$defs/limits"},
    "modules": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/module"}},
    "validation": {"$ref": "#/$defs/validation"},
    "calibration": {"$ref": "#/$defs/calibration"},
    "runtime_artifacts": {"$ref": "#/$defs/runtimeArtifacts"},
    "fit_report": {"type": "object"}
  },
  "allOf": [{
    "if": {"properties": {"schema_version": {"const": 2}}},
    "then": {"required": ["calibration"]},
    "else": {"not": {"required": ["calibration"]}}
  }],
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "positiveInteger": {"type": "integer", "minimum": 1},
    "target": {
      "type": "object",
      "additionalProperties": false,
      "required": ["gpu_name", "gpu_uuid", "pci_vendor_id", "pci_device_id", "compute_capability_major", "compute_capability_minor", "driver_version"],
      "properties": {
        "gpu_name": {"type": "string", "minLength": 1},
        "gpu_uuid": {"type": "string", "minLength": 1},
        "pci_vendor_id": {"$ref": "#/$defs/positiveInteger"},
        "pci_device_id": {"$ref": "#/$defs/positiveInteger"},
        "compute_capability_major": {"const": 12},
        "compute_capability_minor": {"const": 0},
        "driver_version": {"$ref": "#/$defs/positiveInteger"}
      }
    },
    "toolchain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cuda_version", "ptxas_version", "nvdisasm_version", "cuobjdump_version", "ncu_version"],
      "properties": {
        "cuda_version": {"type": "string", "minLength": 1},
        "ptxas_version": {"type": "string", "minLength": 1},
        "nvdisasm_version": {"type": "string", "minLength": 1},
        "cuobjdump_version": {"type": "string", "minLength": 1},
        "ncu_version": {"type": "string", "minLength": 1}
      }
    },
    "clusterShape": {
      "type": "object",
      "additionalProperties": false,
      "required": ["x", "y", "z"],
      "properties": {
        "x": {"$ref": "#/$defs/positiveInteger"},
        "y": {"$ref": "#/$defs/positiveInteger"},
        "z": {"$ref": "#/$defs/positiveInteger"}
      }
    },
    "conditions": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sm_clock_mhz", "memory_clock_mhz", "power_limit_mw", "temperature_min_c", "temperature_max_c", "cache_condition", "concurrency_condition", "cluster_shape"],
      "properties": {
        "sm_clock_mhz": {"$ref": "#/$defs/positiveInteger"},
        "memory_clock_mhz": {"$ref": "#/$defs/positiveInteger"},
        "clock_control": {"enum": ["none"]},
        "sm_clock_min_mhz": {"$ref": "#/$defs/positiveInteger"},
        "sm_clock_max_mhz": {"$ref": "#/$defs/positiveInteger"},
        "memory_clock_min_mhz": {"$ref": "#/$defs/positiveInteger"},
        "memory_clock_max_mhz": {"$ref": "#/$defs/positiveInteger"},
        "power_limit_mw": {"$ref": "#/$defs/positiveInteger"},
        "temperature_min_c": {"type": "integer", "minimum": 0},
        "temperature_max_c": {"type": "integer", "minimum": 0},
        "cache_condition": {"type": "string", "minLength": 1},
        "concurrency_condition": {"type": "string", "minLength": 1},
        "cluster_shape": {"$ref": "#/$defs/clusterShape"}
      },
      "dependentRequired": {
        "clock_control": ["sm_clock_min_mhz", "sm_clock_max_mhz", "memory_clock_min_mhz", "memory_clock_max_mhz"],
        "sm_clock_min_mhz": ["clock_control", "sm_clock_max_mhz", "memory_clock_min_mhz", "memory_clock_max_mhz"],
        "sm_clock_max_mhz": ["clock_control", "sm_clock_min_mhz", "memory_clock_min_mhz", "memory_clock_max_mhz"],
        "memory_clock_min_mhz": ["clock_control", "sm_clock_min_mhz", "sm_clock_max_mhz", "memory_clock_max_mhz"],
        "memory_clock_max_mhz": ["clock_control", "sm_clock_min_mhz", "sm_clock_max_mhz", "memory_clock_min_mhz"]
      }
    },
    "thresholds": {
      "type": "object",
      "additionalProperties": false,
      "required": ["p50_percent", "p95_percent", "counter_percent"],
      "properties": {
        "p50_percent": {"type": "number", "minimum": 0, "maximum": 5},
        "p95_percent": {"type": "number", "minimum": 0, "maximum": 10},
        "counter_percent": {"type": "number", "minimum": 0, "maximum": 10}
      }
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_thread_futures", "max_warp_futures", "max_cta_futures", "max_cluster_futures", "max_thread_async_objects", "max_warp_async_objects", "max_cta_async_objects", "max_cluster_async_objects"],
      "properties": {
        "max_thread_futures": {"$ref": "#/$defs/positiveInteger"},
        "max_warp_futures": {"$ref": "#/$defs/positiveInteger"},
        "max_cta_futures": {"$ref": "#/$defs/positiveInteger"},
        "max_cluster_futures": {"$ref": "#/$defs/positiveInteger"},
        "max_thread_async_objects": {"$ref": "#/$defs/positiveInteger"},
        "max_warp_async_objects": {"$ref": "#/$defs/positiveInteger"},
        "max_cta_async_objects": {"$ref": "#/$defs/positiveInteger"},
        "max_cluster_async_objects": {"$ref": "#/$defs/positiveInteger"}
      }
    },
    "kernel": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "registers", "spill_store_bytes", "spill_load_bytes", "static_shared_bytes", "max_dynamic_shared_bytes", "block_threads", "occupancy_blocks_per_sm"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "registers": {"$ref": "#/$defs/positiveInteger"},
        "spill_store_bytes": {"type": "integer", "minimum": 0},
        "spill_load_bytes": {"type": "integer", "minimum": 0},
        "static_shared_bytes": {"type": "integer", "minimum": 0},
        "max_dynamic_shared_bytes": {"type": "integer", "minimum": 0},
        "block_threads": {"type": "integer", "minimum": 1, "maximum": 1024},
        "occupancy_blocks_per_sm": {"$ref": "#/$defs/positiveInteger"}
      }
    },
    "module": {
      "type": "object",
      "additionalProperties": false,
      "required": ["module_id", "ptx_target", "original_ptx_sha256", "transformed_ptx_sha256", "cubin_sha256", "sass_sha256", "kernels"],
      "properties": {
        "module_id": {"type": "string", "pattern": "^ptx:sha256:[0-9a-f]{64}$"},
        "ptx_target": {"enum": ["sm_120", "sm_120a", "sm_120f"]},
        "original_ptx_sha256": {"$ref": "#/$defs/sha256"},
        "transformed_ptx_sha256": {"$ref": "#/$defs/sha256"},
        "cubin_sha256": {"$ref": "#/$defs/sha256"},
        "sass_sha256": {"$ref": "#/$defs/sha256"},
        "kernels": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/kernel"}}
      }
    },
    "dataset": {
      "type": "object",
      "additionalProperties": false,
      "required": ["manifest_sha256", "case_ids"],
      "properties": {
        "manifest_sha256": {"$ref": "#/$defs/sha256"},
        "case_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "validationClass": {
      "type": "object",
      "additionalProperties": false,
      "required": ["operation_class", "passed", "p50_error_percent", "p95_error_percent", "counter_error_percent"],
      "properties": {
        "operation_class": {"enum": ["ordinary_load", "ordinary_store", "tma_load", "tma_store", "unicast", "multicast", "mixed_hbm_hbf"]},
        "passed": {"type": "boolean"},
        "p50_error_percent": {"type": "number", "minimum": 0},
        "p95_error_percent": {"type": "number", "minimum": 0},
        "counter_error_percent": {"type": "number", "minimum": 0}
      }
    },
    "validation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status"],
      "properties": {
        "status": {"enum": ["pending", "passed", "failed"]},
        "training": {"$ref": "#/$defs/dataset"},
        "holdout": {"$ref": "#/$defs/dataset"},
        "classes": {"type": "array", "minItems": 7, "maxItems": 7, "items": {"$ref": "#/$defs/validationClass"}}
      },
      "allOf": [{
        "if": {"properties": {"status": {"const": "passed"}}},
        "then": {"required": ["training", "holdout", "classes"]}
      }]
    },
    "runtimeArtifacts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundle_root", "prepatched_ptx_dir", "pass_manifest"],
      "properties": {
        "bundle_root": {"type": "string", "pattern": "^/"},
        "prepatched_ptx_dir": {"type": "string", "pattern": "^/"},
        "pass_manifest": {"type": "string", "pattern": "^/"}
      }
    },
    "calibratedQueue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["count", "depth", "arbitration", "service_ns_by_class"],
      "properties": {
        "count": {"$ref": "#/$defs/positiveInteger"},
        "depth": {"$ref": "#/$defs/positiveInteger"},
        "arbitration": {"enum": ["fifo", "round_robin"]},
        "service_ns_by_class": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/positiveInteger"}}
      }
    },
    "routing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "program_sha256", "inputs", "smsp_proxy_lut", "gnic_lut", "gpc_lut"],
      "properties": {
        "version": {"$ref": "#/$defs/positiveInteger"},
        "program_sha256": {"$ref": "#/$defs/sha256"},
        "inputs": {
          "type": "array", "minItems": 6, "maxItems": 6, "uniqueItems": true,
          "items": {"enum": ["smid", "warpid", "cta_shape", "resident_warps", "cluster_ctarank", "operation"]}
        },
        "smsp_proxy_lut": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0}},
        "gnic_lut": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0, "maximum": 3}},
        "gpc_lut": {"type": "array", "minItems": 1, "items": {"type": "integer", "minimum": 0, "maximum": 1}}
      }
    },
    "calibrationResidual": {
      "type": "object", "additionalProperties": false,
      "required": ["operation_class", "p50_error_percent", "p95_error_percent"],
      "properties": {
        "operation_class": {"type": "string", "minLength": 1},
        "p50_error_percent": {"type": "number", "minimum": 0},
        "p95_error_percent": {"type": "number", "minimum": 0}
      }
    },
    "counterThreshold": {
      "type": "object", "additionalProperties": false,
      "required": ["metric", "max_error_percent"],
      "properties": {
        "metric": {"type": "string", "minLength": 1},
        "max_error_percent": {"type": "number", "minimum": 0, "maximum": 10}
      }
    },
    "counterErrorContract": {
      "type": "object", "additionalProperties": false,
      "required": ["version", "percentage_metrics", "traffic_metrics", "duration_metrics", "fallback_metrics"],
      "properties": {
        "version": {"const": 1},
        "percentage_metrics": {"const": "absolute_percentage_points"},
        "traffic_metrics": {"const": "native_or_logical_issued_or_training_class_envelope"},
        "duration_metrics": {"const": "relative_to_native"},
        "fallback_metrics": {"const": "relative_to_native"}
      }
    },
    "workloadDomain": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "match_policy", "program_sha256", "feature_names", "vectors_by_class"],
      "properties": {
        "schema_version": {"const": 1},
        "match_policy": {"const": "exact_calibrated_vector"},
        "program_sha256": {"$ref": "#/$defs/sha256"},
        "feature_names": {
          "const": ["log2_issued_operations", "log2_bytes", "log2_resident_warps", "log2_queue_depth", "dimension_count", "cache_warm", "log2_iterations", "log2_load_use_distance_plus_one", "log2_tile_elements", "cluster_size", "multicast_targets"]
        },
        "vectors_by_class": {
          "type": "object", "additionalProperties": false,
          "required": ["ordinary_load", "ordinary_store", "tma_load", "tma_store", "unicast", "multicast", "mixed_hbm_hbf"],
          "properties": {
            "ordinary_load": {"$ref": "#/$defs/workloadVectors"},
            "ordinary_store": {"$ref": "#/$defs/workloadVectors"},
            "tma_load": {"$ref": "#/$defs/workloadVectors"},
            "tma_store": {"$ref": "#/$defs/workloadVectors"},
            "unicast": {"$ref": "#/$defs/workloadVectors"},
            "multicast": {"$ref": "#/$defs/workloadVectors"},
            "mixed_hbm_hbf": {"$ref": "#/$defs/workloadVectors"}
          }
        }
      }
    },
    "workloadVectors": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {
        "type": "array", "minItems": 11, "maxItems": 11,
        "items": {"type": "number", "minimum": 0}
      }
    },
    "calibration": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label_semantics", "gnic", "gpc", "routing", "metric_names", "raw_training_sha256", "raw_holdout_sha256", "fitted_case_ids", "residuals", "counter_thresholds", "workload_domain"],
      "properties": {
        "label_semantics": {"const": "contention_equivalent"},
        "gnic": {"allOf": [{"$ref": "#/$defs/calibratedQueue"}, {"properties": {"count": {"const": 4}}}]},
        "gpc": {"allOf": [{"$ref": "#/$defs/calibratedQueue"}, {"properties": {"count": {"const": 2}}}]},
        "routing": {"$ref": "#/$defs/routing"},
        "metric_names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "raw_training_sha256": {"$ref": "#/$defs/sha256"},
        "raw_holdout_sha256": {"$ref": "#/$defs/sha256"},
        "fitted_case_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "residuals": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/calibrationResidual"}},
        "counter_thresholds": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/counterThreshold"}},
        "counter_error_contract": {"$ref": "#/$defs/counterErrorContract"},
        "counter_error_scale_by_class": {"type": "object"},
        "workload_domain": {"$ref": "#/$defs/workloadDomain"}
      },
      "dependentRequired": {
        "counter_error_contract": ["counter_error_scale_by_class"],
        "counter_error_scale_by_class": ["counter_error_contract"]
      }
    }
  }
}
