+                    per_module << '\"' << names[field] << "\":" << fields[field];
+                    aggregate_fields[field] += fields[field];
+                }
+                per_module << "},\"trace_drop\":null,\"traces\":[";
+                for (std::size_t trace_index = 0; trace_index < traces.size(); ++trace_index) {
