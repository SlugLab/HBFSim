+namespace {
+
+using hbfsim_llama_launch_probe_fn = int (*)(
+    uint64_t *, uint64_t, cudaStream_t);
+
+struct hbfsim_llama_state {
+    std::mutex mutex;
+    hbfsim_context * context = nullptr;
+    void * probe_library = nullptr;
+    hbfsim_llama_launch_probe_fn launch_probe = nullptr;
+    void * probe_output = nullptr;
+    void * probe_input = nullptr;
+    uint64_t delay_ns = 0;
+    uint64_t probe_launches = 0;
+    std::string injection_report;
+    int device = -1;
+    std::unordered_map<void *, size_t> ranges;
+};
+
+hbfsim_llama_state & hbfsim_llama() {
+    static hbfsim_llama_state state;
+    return state;
+}
+
+std::string hbfsim_json_string(const std::string & json, const char * key) {
+    const std::regex expression(std::string("\\\"") + key +
+                                "\\\"\\s*:\\s*\\\"([^\\\"]+)\\\"");
+    std::smatch match;
+    return std::regex_search(json, match, expression) ? match[1].str() : "";
+}
+
+uint64_t hbfsim_json_u64(const std::string & json, const char * key) {
+    const std::regex expression(std::string("\\\"") + key +
+                                "\\\"\\s*:\\s*([0-9]+)");
+    std::smatch match;
+    return std::regex_search(json, match, expression) ? std::stoull(match[1].str()) : 0;
+}
+
+uint32_t hbfsim_model_mode(const std::string & value) {
+    if (value == "reference") return HBFSIM_MODEL_REFERENCE;
+    if (value == "fast") return HBFSIM_MODEL_FAST;
+    if (value == "hybrid") return HBFSIM_MODEL_HYBRID;
+    throw std::runtime_error("LLAMA_HBFSIM_CONFIG has invalid timing_model");
+}
+
+void hbfsim_check(int status, const char * operation) {
+    if (status != HBFSIM_OK) {
+        throw std::runtime_error(std::string(operation) + " failed with HBFSim status " + std::to_string(status));
+    }
+}
+
+void hbfsim_initialize_locked(hbfsim_llama_state & state, int device) {
+    if (state.context != nullptr) return;
+    const char * config_path = std::getenv("LLAMA_HBFSIM_CONFIG");
+    if (config_path == nullptr || config_path[0] == '\0') return;
+    std::ifstream config_input(config_path);
+    if (!config_input) throw std::runtime_error("cannot open LLAMA_HBFSIM_CONFIG");
+    const std::string config{std::istreambuf_iterator<char>(config_input), {}};
+    const auto profile = hbfsim_json_string(config, "profile_path");
+    const auto report = hbfsim_json_string(config, "report_dir");
+    const auto model = hbfsim_json_string(config, "timing_model");
+    const auto probe_path = hbfsim_json_string(config, "probe_ptx");
+    const auto probe_library = hbfsim_json_string(config, "probe_library");
+    const auto delay_ns = hbfsim_json_u64(config, "delay_ns");
+    const auto range_mode = hbfsim_json_string(config, "range_mode");
+    if (profile.empty() || report.empty() || model.empty() ||
+        probe_path.empty() || probe_library.empty() || delay_ns == 0) {
+        throw std::runtime_error("LLAMA_HBFSIM_CONFIG is missing required fields");
+    }
+    if (!range_mode.empty() && range_mode != "timing") {
+        throw std::runtime_error("llama.cpp adapter rejects uninstrumented capacity ranges");
+    }
+    hbfsim_options options{
+        profile.c_str(), report.c_str(), hbfsim_model_mode(model), 256,
+        30'000'000'000ULL,
+    };
+    hbfsim_check(hbfsim_context_create(&options, &state.context),
+                 "hbfsim_context_create");
+    state.device = device;
+    state.delay_ns = delay_ns;
+    state.injection_report = report + "/llama-injection.jsonl";
+    std::ifstream ptx_input(probe_path, std::ios::binary);
+    if (!ptx_input) throw std::runtime_error("cannot open HBFSim llama probe PTX");
+    // Static llama.cpp fatbins are intentionally skipped by the runner.  Turn
+    // automatic extraction back on only for this small dlopen boundary.
+    (void) unsetenv("BPFTIME_CUDA_DISABLE_CUOBJDUMP");
+    state.probe_library = dlopen(probe_library.c_str(), RTLD_NOW | RTLD_LOCAL);
+    if (state.probe_library == nullptr) {
+        throw std::runtime_error(std::string("cannot load HBFSim llama probe: ") + dlerror());
+    }
+    state.launch_probe = reinterpret_cast<hbfsim_llama_launch_probe_fn>(
+        dlsym(state.probe_library, "hbfsim_llama_launch_probe"));
+    if (state.launch_probe == nullptr) {
+        throw std::runtime_error("HBFSim llama probe is missing launch entrypoint");
+    }
+    CUDA_CHECK(cudaMalloc(&state.probe_output, sizeof(uint64_t)));
+}
+
+bool hbfsim_register_weight_buffer(void * pointer, size_t bytes, int device) {
+    const char * config = std::getenv("LLAMA_HBFSIM_CONFIG");
+    if (config == nullptr || config[0] == '\0') return false;
+    auto & state = hbfsim_llama();
+    std::lock_guard<std::mutex> lock(state.mutex);
+    hbfsim_initialize_locked(state, device);
+    if (state.device != device) {
+        throw std::runtime_error("HBFSim llama adapter supports one CUDA device");
+    }
+    if (state.ranges.find(pointer) != state.ranges.end()) return true;
+    const hbfsim_range_options range{
+        HBFSIM_RANGE_MODE_TIMING, HBFSIM_RANGE_READ,
+        HBFSIM_CACHE_POLICY_NONE, 0,
+    };
+    hbfsim_check(hbfsim_register_device(state.context, pointer, bytes, &range),
+                 "hbfsim_register_device(weight buffer)");
+    state.ranges.emplace(pointer, bytes);
+    if (state.probe_input == nullptr) state.probe_input = pointer;
+    GGML_LOG_INFO("HBFSim: registered CUDA weight buffer %p (%zu bytes)\n", pointer, bytes);
+    return true;
+}
+
+void hbfsim_unregister_weight_buffer(void * pointer) noexcept {
+    auto & state = hbfsim_llama();
+    std::lock_guard<std::mutex> lock(state.mutex);
+    if (state.context == nullptr || state.ranges.find(pointer) == state.ranges.end()) return;
+    if (hbfsim_unregister(state.context, pointer) != HBFSIM_OK) {
+        GGML_LOG_ERROR("HBFSim: failed to unregister CUDA weight buffer %p\n", pointer);
+        return;
+    }
+    state.ranges.erase(pointer);
+    if (state.probe_input == pointer) {
+        state.probe_input = state.ranges.empty() ? nullptr : state.ranges.begin()->first;
+    }
+    if (!state.ranges.empty()) return;
+    hbfsim_stats stats{};
+    if (hbfsim_get_stats(state.context, &stats) == HBFSIM_OK) {
+        GGML_LOG_INFO("HBFSim llama stats: submitted=%llu completed=%llu fast=%llu reference=%llu modeled_ns=%llu probe_launches=%llu injected_ns=%llu\n",
+                      (unsigned long long) stats.requests_submitted,
+                      (unsigned long long) stats.requests_completed,
+                      (unsigned long long) stats.fast_requests,
+                      (unsigned long long) stats.reference_requests,
+                      (unsigned long long) stats.fast_modeled_ns,
+                      (unsigned long long) state.probe_launches,
+                      (unsigned long long) (state.probe_launches * state.delay_ns));
+    }
+    if (state.probe_output != nullptr) (void) cudaFree(state.probe_output);
+    if (state.probe_library != nullptr) (void) dlclose(state.probe_library);
+    hbfsim_context_destroy(state.context);
+    state.context = nullptr;
+    state.probe_output = nullptr;
+    state.probe_library = nullptr;
+    state.launch_probe = nullptr;
+    state.probe_input = nullptr;
+    state.delay_ns = 0;
+    state.probe_launches = 0;
+    state.injection_report.clear();
+    state.device = -1;
+}
+
+void hbfsim_launch_llama_probe(cudaStream_t stream) {
+    auto & state = hbfsim_llama();
+    std::lock_guard<std::mutex> lock(state.mutex);
+    if (state.context == nullptr || state.probe_input == nullptr ||
+        state.probe_output == nullptr || state.launch_probe == nullptr) return;
+    CUDA_CHECK(static_cast<cudaError_t>(state.launch_probe(
+        static_cast<uint64_t *>(state.probe_output), state.delay_ns, stream)));
+    ++state.probe_launches;
+    std::ofstream trace(state.injection_report, std::ios::app);
+    trace << "{\"launch\":" << state.probe_launches
+          << ",\"delay_ns\":" << state.delay_ns << "}\n";
+}
+
+} // namespace
+#endif
