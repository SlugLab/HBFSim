{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "HBFSim normalized 3D-ICE golden dataset v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "trace_id", "trace_kind", "sample_period_ns", "input_names", "output_names", "samples", "provenance"],
  "properties": {
    "schema_version": {"const": 1},
    "trace_id": {"type": "string", "minLength": 1},
    "trace_kind": {"enum": ["unit_step", "square_wave", "burst", "mixed_gpu_hbm_hbf", "write_heavy_hbf", "read_heavy_hbf"]},
    "sample_period_ns": {"type": "integer", "minimum": 1},
    "input_names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "output_names": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "samples": {
      "type": "array", "minItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["time_ns", "power_w", "temperature_c"],
        "properties": {
          "time_ns": {"type": "integer", "minimum": 0},
          "power_w": {"type": "array", "items": {"type": "number", "minimum": 0}},
          "temperature_c": {"type": "array", "items": {"type": "number", "minimum": -273.15}}
        }
      }
    },
    "provenance": {"type": "object"}
  }
}
