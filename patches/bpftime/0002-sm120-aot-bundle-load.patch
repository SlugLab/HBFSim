diff --git a/attach/nv_attach_impl/test/test_aot_bundle.cpp b/attach/nv_attach_impl/test/test_aot_bundle.cpp
new file mode 100644
index 0000000..66217c2
--- /dev/null
+++ b/attach/nv_attach_impl/test/test_aot_bundle.cpp
@@ -0,0 +1,175 @@
+#include "nv_attach_aot_bundle.hpp"
+#include "nv_attach_utils.hpp"
+
+#include <catch2/catch_test_macros.hpp>
+
+#include <array>
+#include <cstdlib>
+#include <filesystem>
+#include <fstream>
+#include <string>
+#include <unistd.h>
+#include <vector>
+
+using namespace bpftime::attach;
+namespace fs = std::filesystem;
+
+namespace
+{
+
+constexpr std::uintmax_t kOversizedCubinBytes =
+	1024ULL * 1024 * 1024 + 1;
+const std::string kOriginalDigest(64, 'a');
+const std::string kTransformedDigest(64, 'c');
+
+class bundle_fixture {
+    public:
+	bundle_fixture()
+	{
+		static unsigned sequence;
+		root = fs::temp_directory_path() /
+		       ("hbfsim-aot-bundle-" + std::to_string(getpid()) + "-" +
+			std::to_string(sequence++));
+		fs::remove_all(root);
+		fs::create_directories(root / kOriginalDigest);
+		REQUIRE(setenv("HBFSIM_EXACT_BUNDLE_DIR", root.c_str(), 1) == 0);
+	}
+
+	~bundle_fixture()
+	{
+		unsetenv("HBFSIM_EXACT_BUNDLE_DIR");
+		std::error_code error;
+		fs::remove_all(root, error);
+	}
+
+	fs::path create_target(std::string_view target = "sm_120") const
+	{
+		auto path = root / kOriginalDigest / target;
+		fs::create_directories(path);
+		return path;
+	}
+
+	void write_cubin(const fs::path &target) const
+	{
+		std::ofstream output(target / "module.cubin", std::ios::binary);
+		output.write(reinterpret_cast<const char *>(cubin.data()),
+			     cubin.size());
+		REQUIRE(output.good());
+	}
+
+	void write_artifact(const fs::path &target,
+			    std::string_view original = kOriginalDigest,
+			    std::string_view cubin_digest = {}) const
+	{
+		const auto resolved_digest = cubin_digest.empty() ?
+			sha256(cubin.data(), cubin.size()) : std::string(cubin_digest);
+		std::ofstream output(target / "artifact.json");
+		output << "{\"original_ptx_sha256\":\"" << original
+		       << "\",\"transformed_ptx_sha256\":\""
+		       << kTransformedDigest
+		       << "\",\"cubin_sha256\":\"" << resolved_digest
+		       << "\",\"ptx_target\":\"" << target.filename().string()
+		       << "\"}";
+		REQUIRE(output.good());
+	}
+
+	void write_valid(const fs::path &target) const
+	{
+		write_cubin(target);
+		write_artifact(target);
+	}
+
+	fs::path root;
+	const std::array<unsigned char, 4> cubin{ 0x7f, 'E', 'L', 'F' };
+};
+
+} // namespace
+
+TEST_CASE("valid exact AOT bundle loads", "[aot_bundle]")
+{
+	bundle_fixture fixture;
+	const auto target = fixture.create_target();
+	fixture.write_valid(target);
+	REQUIRE(exact_aot_enabled());
+	const auto bundle = load_exact_aot_bundle(kOriginalDigest);
+	REQUIRE(bundle.cubin ==
+		std::vector<uint8_t>(fixture.cubin.begin(), fixture.cubin.end()));
+	REQUIRE(bundle.ptx_target == "sm_120");
+	REQUIRE(bundle.transformed_ptx_sha256 == kTransformedDigest);
+	REQUIRE(bundle.cubin_sha256 ==
+		sha256(fixture.cubin.data(), fixture.cubin.size()));
+}
+
+TEST_CASE("missing and duplicate targets reject", "[aot_bundle]")
+{
+	bundle_fixture fixture;
+	REQUIRE_THROWS(load_exact_aot_bundle(kOriginalDigest));
+	fixture.write_valid(fixture.create_target("sm_120"));
+	fixture.write_valid(fixture.create_target("sm_120a"));
+	REQUIRE_THROWS(load_exact_aot_bundle(kOriginalDigest));
+}
+
+TEST_CASE("symlink bundle members reject", "[aot_bundle]")
+{
+	bundle_fixture fixture;
+	const auto target = fixture.create_target();
+	const auto outside = fixture.root / "outside.cubin";
+	{
+		std::ofstream output(outside, std::ios::binary);
+		output.write(reinterpret_cast<const char *>(fixture.cubin.data()),
+			     fixture.cubin.size());
+	}
+	fs::create_symlink(outside, target / "module.cubin");
+	fixture.write_artifact(target);
+	REQUIRE_THROWS(load_exact_aot_bundle(kOriginalDigest));
+}
+
+TEST_CASE("oversized bundle members reject", "[aot_bundle]")
+{
+	bundle_fixture fixture;
+	const auto target = fixture.create_target();
+	{
+		std::ofstream output(target / "module.cubin", std::ios::binary);
+		output.put('\0');
+	}
+	fs::resize_file(target / "module.cubin", kOversizedCubinBytes);
+	fixture.write_artifact(target);
+	REQUIRE_THROWS(load_exact_aot_bundle(kOriginalDigest));
+}
+
+TEST_CASE("malformed and mismatched artifacts reject", "[aot_bundle]")
+{
+	bundle_fixture fixture;
+	const auto target = fixture.create_target();
+	fixture.write_cubin(target);
+
+	SECTION("malformed")
+	{
+		std::ofstream(target / "artifact.json") << "{}";
+		REQUIRE_THROWS(load_exact_aot_bundle(kOriginalDigest));
+	}
+	SECTION("wrong original digest")
+	{
+		fixture.write_artifact(target, std::string(64, 'b'));
+		REQUIRE_THROWS(load_exact_aot_bundle(kOriginalDigest));
+	}
+	SECTION("wrong cubin digest")
+	{
+		fixture.write_artifact(target, kOriginalDigest,
+				       std::string(64, 'b'));
+		REQUIRE_THROWS(load_exact_aot_bundle(kOriginalDigest));
+	}
+	SECTION("duplicated identity field")
+	{
+		std::ofstream output(target / "artifact.json");
+		output << "{\"original_ptx_sha256\":\"" << kOriginalDigest
+		       << "\",\"original_ptx_sha256\":\"" << kOriginalDigest
+		       << "\",\"transformed_ptx_sha256\":\""
+		       << kTransformedDigest
+		       << "\",\"cubin_sha256\":\""
+		       << sha256(fixture.cubin.data(), fixture.cubin.size())
+		       << "\",\"ptx_target\":\"sm_120\"}";
+		output.close();
+		REQUIRE_THROWS(load_exact_aot_bundle(kOriginalDigest));
+	}
+}
