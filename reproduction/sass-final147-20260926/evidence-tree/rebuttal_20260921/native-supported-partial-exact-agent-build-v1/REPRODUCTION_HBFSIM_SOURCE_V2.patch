+STRICT_DENIAL_CAPABILITY = "hbfsim_strict_denial_capabilities_v1"
+STRICT_DENIAL_CAPABILITY_STOP_ON_FIRST = 1 << 0
+STRICT_DENIAL_ENV = "HBFSIM_STRICT_STOP_ON_DENIAL_PATH"
