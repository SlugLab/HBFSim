+std::string diagnostic_json_escape(const char* value)
+{
+    std::ostringstream out;
+    const unsigned char* cursor = reinterpret_cast<const unsigned char*>(
+        value != nullptr ? value : "");
+    for (; *cursor != 0; ++cursor) {
+        switch (*cursor) {
+        case '\\': out << "\\\\"; break;
+        case '"': out << "\\\""; break;
+        case '\n': out << "\\n"; break;
+        case '\r': out << "\\r"; break;
+        case '\t': out << "\\t"; break;
+        default:
+            if (*cursor < 0x20) {
+                out << "\\u" << std::hex << std::setw(4)
+                    << std::setfill('0') << static_cast<unsigned>(*cursor)
+                    << std::dec << std::setfill(' ');
