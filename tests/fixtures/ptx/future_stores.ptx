.version 8.7
.target sm_120
.address_size 64

.visible .entry future_stores(
    .param .u64 output
)
{
    .reg .pred %p<4>;
    .reg .b32 %r<32>;
    .reg .b64 %rd<8>;
    ld.param.u64 %rd1, [output];
    mov.u32 %r1, 7;
    st.global.u32 [%rd1], %r1;
    mov.u32 %r1, 9;
    add.u32 %r20, %r10, 1;
    fence.release.gpu;
    atom.global.add.u32 %r2, [%rd1+4], %r1;
    mov.u32 %r1, 11;
    add.u32 %r3, %r2, 1;
    @%p1 st.global.v2.u32 [%rd1+8], {%r1, %r3};
    mov.u32 %r1, 13;
    mov.u32 %r3, 15;
    st.global.release.gpu.u32 [%rd1+16], %r1;
    ret;
}

.visible .entry unsupported_atomic(
    .param .u64 output
)
{
    .reg .f32 %f<8>;
    .reg .b64 %rd<8>;
    ld.param.u64 %rd1, [output];
    atom.global.add.f32 %f1, [%rd1], %f2;
    ret;
}
