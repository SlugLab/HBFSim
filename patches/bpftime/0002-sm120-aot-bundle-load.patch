--- /dev/null
+++ b/attach/nv_attach_impl/nv_attach_aot_load_provenance.cpp
@@ -0,0 +1,44 @@
+#include "nv_attach_aot_load_provenance.hpp"
+
+#include <dlfcn.h>
+
+namespace bpftime::attach
+{
+
+aot_module_load_hooks find_aot_module_load_hooks()
+{
+	return {
+		.begin = reinterpret_cast<begin_aot_module_load_fn>(dlsym(
+			RTLD_DEFAULT, "hbfsim_begin_module_load_from_aot")),
+		.end = reinterpret_cast<end_aot_module_load_fn>(
+			dlsym(RTLD_DEFAULT, "hbfsim_end_module_load")),
+	};
+}
+
+aot_module_load_scope::aot_module_load_scope(
+	const void *cubin, size_t cubin_bytes, std::string_view artifact_json,
+	aot_module_load_hooks hooks)
+{
+	if (cubin == nullptr || cubin_bytes == 0 || artifact_json.empty() ||
+	    hooks.begin == nullptr || hooks.end == nullptr)
+		return;
+	token_ = hooks.begin(cubin, cubin_bytes, artifact_json.data(),
+			     artifact_json.size());
+	if (token_ == 0)
+		return;
+	end_ = hooks.end;
+	permitted_ = true;
+}
+
+aot_module_load_scope::~aot_module_load_scope()
+{
+	if (token_ != 0 && end_ != nullptr)
+		end_(token_);
+}
+
+bool aot_module_load_scope::permits_load() const
+{
+	return permitted_;
+}
+
+} // namespace bpftime::attach
diff --git a/attach/nv_attach_impl/nv_attach_aot_load_provenance.hpp b/attach/nv_attach_impl/nv_attach_aot_load_provenance.hpp
