{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sluglab.github.io/HBFSim/hbf-profile.schema.json",
  "title": "HBFSim device profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "name",
    "capacity_bytes",
    "page_bytes",
    "read_latency_ns",
    "program_latency_ns",
    "channels",
    "dies_per_channel",
    "planes_per_die",
    "pages_per_block",
    "channel_width_bits",
    "channel_transfer_rate_mtps",
    "queue_depth",
    "aggregate_bandwidth_bytes_per_s",
    "hbm_cache_bytes",
    "reference_sample_rate",
    "reference_warmup_requests",
    "time_scale",
    "timing_tolerance_ns"
  ],
  "properties": {
    "name": { "type": "string", "minLength": 1 },
    "capacity_bytes": { "type": "integer", "minimum": 1 },
    "page_bytes": { "type": "integer", "minimum": 512 },
    "read_latency_ns": { "type": "integer", "minimum": 1 },
    "program_latency_ns": { "type": "integer", "minimum": 1 },
    "channels": { "type": "integer", "minimum": 1 },
    "dies_per_channel": { "type": "integer", "minimum": 1 },
    "planes_per_die": { "type": "integer", "minimum": 1 },
    "pages_per_block": { "type": "integer", "minimum": 1 },
    "channel_width_bits": { "type": "integer", "minimum": 1 },
    "channel_transfer_rate_mtps": { "type": "integer", "minimum": 1 },
    "queue_depth": { "type": "integer", "minimum": 1 },
    "aggregate_bandwidth_bytes_per_s": { "type": "integer", "minimum": 1 },
    "hbm_cache_bytes": { "type": "integer", "minimum": 0 },
    "reference_sample_rate": { "type": "number", "minimum": 0, "maximum": 1 },
    "reference_warmup_requests": { "type": "integer", "minimum": 0 },
    "time_scale": { "type": "integer", "minimum": 1 },
    "timing_tolerance_ns": { "type": "integer", "minimum": 0 },
    "thermal_reliability": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "temperature_source",
        "ambient_c",
        "initial_hbf_junction_c",
        "tau_seconds",
        "gpu_coupling_ratio",
        "thermal_resistance_c_per_w",
        "idle_power_w",
        "read_energy_j_per_byte",
        "write_energy_j_per_byte",
        "telemetry_period_ms",
        "controller_period_ms",
        "rtt_c",
        "ltt_c",
        "stt_c",
        "shutdown_c",
        "light_service_ppm",
        "zone_bytes",
        "reference_retention_hours",
        "reference_retention_temperature_c",
        "retention_activation_energy_ev",
        "refresh_damage_threshold",
        "read_disturb_limit",
        "refresh_quantum_bytes",
        "registered_ranges_contain_valid_data",
        "reliability_time_acceleration",
        "max_pec",
        "reference_mtbf_hours",
        "mtbf_reference_temperature_c",
        "mtbf_activation_energy_ev_min",
        "mtbf_activation_energy_ev_max",
        "mtbf_activation_energy_ev_step",
        "source_sha256"
      ],
      "properties": {
        "temperature_source": {
          "enum": ["live_gpu", "trace", "constant"]
        },
        "ambient_c": { "type": "number", "minimum": 0, "maximum": 105 },
        "initial_hbf_junction_c": {
          "type": "number",
          "minimum": 0,
          "maximum": 105
        },
        "tau_seconds": { "type": "number", "exclusiveMinimum": 0 },
        "gpu_coupling_ratio": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "thermal_resistance_c_per_w": { "type": "number", "minimum": 0 },
        "idle_power_w": { "type": "number", "minimum": 0 },
        "read_energy_j_per_byte": { "type": "number", "minimum": 0 },
        "write_energy_j_per_byte": { "type": "number", "minimum": 0 },
        "telemetry_period_ms": { "type": "integer", "minimum": 1 },
        "controller_period_ms": { "type": "integer", "minimum": 1 },
        "rtt_c": { "type": "number", "minimum": 0, "maximum": 105 },
        "ltt_c": { "type": "number", "minimum": 0, "maximum": 105 },
        "stt_c": { "type": "number", "minimum": 0, "maximum": 105 },
        "shutdown_c": { "type": "number", "minimum": 0, "maximum": 105 },
        "light_service_ppm": {
          "type": "integer",
          "minimum": 1,
          "maximum": 999999
        },
        "zone_bytes": { "type": "integer", "minimum": 1 },
        "reference_retention_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reference_retention_temperature_c": {
          "type": "number",
          "minimum": 0,
          "maximum": 105
        },
        "retention_activation_energy_ev": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "refresh_damage_threshold": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1
        },
        "read_disturb_limit": { "type": "integer", "minimum": 1 },
        "refresh_quantum_bytes": { "type": "integer", "minimum": 1 },
        "registered_ranges_contain_valid_data": { "type": "boolean" },
        "reliability_time_acceleration": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "max_pec": { "type": "integer", "minimum": 1 },
        "reference_mtbf_hours": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "mtbf_reference_temperature_c": {
          "type": "number",
          "minimum": 0,
          "maximum": 105
        },
        "mtbf_activation_energy_ev_min": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "mtbf_activation_energy_ev_max": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "mtbf_activation_energy_ev_step": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "empirical_vmem": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_kind",
        "source_sha256",
        "source_capacity_bytes",
        "quantile",
        "sample_count",
        "read_curve",
        "program_p50_ns",
        "program_p95_ns"
      ],
      "properties": {
        "source_kind": { "type": "string", "minLength": 1 },
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "source_capacity_bytes": { "type": "integer", "minimum": 1 },
        "quantile": { "const": "p50" },
        "sample_count": { "type": "integer", "minimum": 1 },
        "read_curve": {
          "type": "array",
          "minItems": 6,
          "maxItems": 6,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["pages", "cumulative_ns", "p95_ns"],
            "properties": {
              "pages": { "type": "integer", "minimum": 1, "maximum": 1023 },
              "cumulative_ns": { "type": "integer", "minimum": 1 },
              "p95_ns": { "type": "integer", "minimum": 1 }
            }
          }
        },
        "program_p50_ns": { "type": "integer", "minimum": 1 },
        "program_p95_ns": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
